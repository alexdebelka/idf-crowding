# Copy to .env (in this folder or any parent folder). Never commit the real file.

# PRIM API key (prim.iledefrance-mobilites.fr, free account)
PRIM_API_KEY=your-prim-token-here

# Backup of data/live (optional). rclone destination, e.g. "r2:your-bucket/live".
BACKUP_REMOTE=
# rclone remote "r2" defined through env vars (Cloudflare R2, token scoped to one bucket):
RCLONE_CONFIG_R2_TYPE=s3
RCLONE_CONFIG_R2_PROVIDER=Cloudflare
RCLONE_CONFIG_R2_ACCESS_KEY_ID=
RCLONE_CONFIG_R2_SECRET_ACCESS_KEY=
RCLONE_CONFIG_R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
RCLONE_CONFIG_R2_NO_CHECK_BUCKET=true
