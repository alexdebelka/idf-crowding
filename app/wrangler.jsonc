// Cloudflare Workers static assets (ADR 0001, ADR 0003): serves app/out.
// Headers of the static files come from public/_headers (copied to out/_headers by the build).
// The Worker script only answers /api/* (next departures, ADR 0004); every other request is a
// static asset request and never invokes it. Secret: `npx wrangler secret put PRIM_API_KEY`.
{
  "name": "idf-crowding",
  "compatibility_date": "2026-10-01",
  "main": "./worker/index.ts",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    // trailingSlash export: /a-propos/ is out/a-propos/index.html (this is also Cloudflare's default)
    "html_handling": "auto-trailing-slash",
    // unknown paths: out/404.html with a 404 status
    "not_found_handling": "404-page"
  }
}
